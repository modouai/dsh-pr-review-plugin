{
  "name": "@modouai/dsh-pr-review",
  "version": "0.3.0",
  "type": "module",
  "main": "index.js",
  "description": "Review pull requests from GitHub, GitLab, Gitea/Forgejo, Gitee, GitCode, AtomGit and Codeup in the DeepSeek Harness Web UI: automatic rounds, per-file analysis, conclusion history, and chat-integrated review tools.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "pull-request",
    "code-review",
    "github",
    "gitlab",
    "gitea",
    "forgejo",
    "gitee",
    "gitcode",
    "atomgit",
    "codeup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modouai/dsh-pr-review-plugin.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1"
  },
  "files": [
    "index.js",
    "client.js",
    "providers.js",
    "provider-common.js",
    "provider-http.js",
    "provider-github-gitea.js",
    "provider-gitlab.js",
    "provider-gitee.js",
    "provider-codeup.js",
    "diff.js",
    "llm.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT"
}
